<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Configuration pour les tests -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Désactiver les logs d'erreur pour les tests de gestion d'exception -->
    <logger name="com.taxinopli.tluc.service.LiveStatusCacheServiceSimple" level="WARN" />
    
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
